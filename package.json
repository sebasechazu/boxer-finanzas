{
  "name": "mi-app-finanzas",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "emulators": "firebase emulators:start --import=./firebase_data --export-on-exit",
    "seed": "tsx ./scripts/seed-test-data.ts",
    "generate:env": "tsx scripts/generate-env.ts",
    "generate:env:local": "tsx --env-file=.env.local scripts/generate-env.ts",
    "deploy": "npm run generate:env && npm run build && firebase deploy --only firestore,auth,hosting",
    "storybook": "ng run app:storybook",
    "build-storybook": "ng run app:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/pwa": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@angular/service-worker": "^22.0.1",
    "@ionic/angular": "^8.0.0",
    "@ionic/storage-angular": "^4.0.0",
    "firebase": "^12.10.0",
    "ionicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.1",
    "@analogjs/vitest-angular": "^2.6.1",
    "@angular-devkit/architect": "^0.2200.1",
    "@angular-devkit/build-angular": "^22.0.1",
    "@angular-devkit/core": "^22.0.1",
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@angular/language-service": "^22.0.1",
    "@compodoc/compodoc": "^1.2.1",
    "@ionic/angular-toolkit": "^12.0.0",
    "@storybook/addon-a11y": "^10.4.5",
    "@storybook/addon-docs": "^10.4.5",
    "@storybook/addon-onboarding": "^10.4.5",
    "@storybook/angular": "^10.4.5",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "firebase-admin": "^14.0.0",
    "firebase-tools": "^15.10.0",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.5",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "description": "An Ionic project"
}
