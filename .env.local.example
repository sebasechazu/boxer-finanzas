# ──────────────────────────────────────────────────────────────────────────────
# .env.local.example
#
# Copiá este archivo como ".env.local" y completá con tus valores reales.
# El archivo .env.local NUNCA debe commitearse al repositorio.
#
# Uso:
#   node --env-file=.env.local scripts/generate-env.mjs   (Node >= 20.6)
#
# Obtené los valores en:
#   Firebase Console → tu proyecto → Configuración del proyecto → Tus apps
# ──────────────────────────────────────────────────────────────────────────────

FIREBASE_API_KEY=tu-api-key-aqui
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
