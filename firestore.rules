rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Perfiles de usuario ─────────────────────────────────────────────────
    // Cada usuario puede leer/escribir su propio perfil.
    // Los colaboradores pueden leer el perfil del propietario al que asisten.
    match /usuarios/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || 
        exists(/databases/$(database)/documents/colaboradores/$(uid + '_' + request.auth.uid))
      );
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Invitaciones ────────────────────────────────────────────────────────
    // Solo el propietario puede crear invitaciones desde su cuenta.
    // El propietario y el invitado (por email) pueden leer y actualizar.
    match /invitaciones/{invId} {
      allow read: if request.auth != null && (
        resource.data.propietarioUid == request.auth.uid ||
        request.auth.token.email.lower() == resource.data.emailInvitado.lower()
      );
      allow create: if request.auth != null
        && request.resource.data.propietarioUid == request.auth.uid
        && request.resource.data.estado == 'PENDIENTE';
      allow update: if request.auth != null
        && request.resource.data.propietarioUid == resource.data.propietarioUid
        && request.resource.data.emailInvitado.lower() == resource.data.emailInvitado.lower()
        && (
          resource.data.propietarioUid == request.auth.uid
          || (
            request.auth.token.email.lower() == resource.data.emailInvitado.lower()
            && (request.resource.data.estado == 'ACEPTADA' || request.resource.data.estado == 'RECHAZADA')
          )
        );
    }

    // ── Colaboradores ───────────────────────────────────────────────────────
    // Solo pueden leer quienes son propietario o colaborador en ese documento.
    // La creación la hace el colaborador al aceptar (su UID debe coincidir).
    // Se valida contra la invitación correspondiente para evitar autopromociones no autorizadas.
    // El propietario o colaborador pueden borrar (revocar acceso).
    match /colaboradores/{colId} {
      allow read: if request.auth != null && (
        resource.data.propietarioUid == request.auth.uid ||
        resource.data.colaboradorUid == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.colaboradorUid == request.auth.uid
        && exists(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacionId))
        && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacionId)).data.emailInvitado.lower() == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.invitacionId)).data.propietarioUid == request.resource.data.propietarioUid;
      allow delete: if request.auth != null && (
        resource.data.propietarioUid == request.auth.uid ||
        resource.data.colaboradorUid == request.auth.uid
      );
    }

    // ── Datos financieros ───────────────────────────────────────────────────
    // Se permite el acceso si sos el propietario (usuarioId == uid)
    // o si sos colaborador registrado (existe doc en colaboradores/{propietarioUid}_{tuUid}).

    function esOwnerOColaborador(ownerUid) {
      return request.auth.uid == ownerUid
        || exists(/databases/$(database)/documents/colaboradores/$(ownerUid + '_' + request.auth.uid));
    }

    match /clientes/{id} {
      allow read, delete: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId);
      allow create: if request.auth != null && esOwnerOColaborador(request.resource.data.usuarioId);
      allow update: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId) && request.resource.data.usuarioId == resource.data.usuarioId;
    }

    match /articulos/{id} {
      allow read, delete: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId);
      allow create: if request.auth != null && esOwnerOColaborador(request.resource.data.usuarioId);
      allow update: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId) && request.resource.data.usuarioId == resource.data.usuarioId;
    }

    match /planes_prestamo/{id} {
      allow read, delete: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId);
      allow create: if request.auth != null && esOwnerOColaborador(request.resource.data.usuarioId);
      allow update: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId) && request.resource.data.usuarioId == resource.data.usuarioId;
    }

    match /prestamos/{id} {
      allow read, delete: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId);
      allow create: if request.auth != null && esOwnerOColaborador(request.resource.data.usuarioId);
      allow update: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId) && request.resource.data.usuarioId == resource.data.usuarioId;
    }

    match /ventas/{id} {
      allow read, delete: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId);
      allow create: if request.auth != null && esOwnerOColaborador(request.resource.data.usuarioId);
      allow update: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId) && request.resource.data.usuarioId == resource.data.usuarioId;
    }

    match /operaciones/{id} {
      allow read, delete: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId);
      allow create: if request.auth != null && esOwnerOColaborador(request.resource.data.usuarioId);
      allow update: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId) && request.resource.data.usuarioId == resource.data.usuarioId;
    }

    match /cuotas/{id} {
      allow read, delete: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId);
      allow create: if request.auth != null && esOwnerOColaborador(request.resource.data.usuarioId);
      allow update: if request.auth != null && esOwnerOColaborador(resource.data.usuarioId) && request.resource.data.usuarioId == resource.data.usuarioId;
    }
  }
}
